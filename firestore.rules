rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ----------------------------------------------------------------------
    // Functions
    // ----------------------------------------------------------------------
    
    // Check if user is authenticated and verified admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == "youssefosama@gmail.com" ||
        request.auth.token.email == "youssef@yaqeen.app"
      );
    }
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ----------------------------------------------------------------------
    // Rules
    // ----------------------------------------------------------------------

    // Users and their subcollections (Private data: emails, phones, passwords)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId) || isAdmin();
      
      // Subcollections inside users (completed_quests, completed_surahs, etc.)
      match /{subCollection}/{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // Global Quests
    match /global_quests/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chatbot Logs
    match /chatbot_logs/{document=**} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }
    
    // Admin Push Notifications
    match /admin_push_notifications/{document=**} {
      allow read, write: if isAdmin();
    }

    // Settings
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // TikTok Accounts
    match /tiktok_accounts/{document=**} {
      allow read, write: if isAdmin();
    }

    // TikTok Scheduled/Published Jobs
    match /tiktok_jobs/{document=**} {
      allow read, write: if isAdmin();
    }

    // TikTok Logs
    match /tiktok_logs/{document=**} {
      allow read, write: if isAdmin();
    }

    // Email Logs
    match /emailLogs/{document=**} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }

    // Admin Logs
    match /admin_logs/{document=**} {
      allow read, write: if isAdmin();
    }

    // Support Tickets
    match /support_tickets/{document=**} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Subscription Requests
    match /subscription_requests/{document=**} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Showcase
    match /showcase/{document=**} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if (isAuthenticated() && request.auth.uid == resource.data.userId) || isAdmin();
    }

    // Community Posts (Social Feed)
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if (isAuthenticated() && request.auth.uid == resource.data.userId) || isAdmin();
      
      match /likes/{likeId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if (isAuthenticated() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.commenterId)) || isAdmin();
      }

      match /reports/{reportId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Friend Requests
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId
                    && (
                      !('blockedUsers' in get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data)
                      || !(request.auth.uid in get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data.blockedUsers)
                    );
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }

    // Friendships
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.users;
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.users;
    }

    // Direct Chats
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Duels (Friend Challenges)
    match /duels/{duelId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
    }

    // Admin configuration (maintenance status, etc.)
    // config doc is read by all visitors (AuthGate maintenance check)
    match /admin/config {
      allow read: if true;
      allow write: if isAdmin();
    }
    // All other admin docs — admin only
    match /admin/{document} {
      allow read, write: if isAdmin();
    }

    // Backgrounds
    match /backgrounds/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Video Renders Logs
    match /video_renders/{jobId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Default Fallback: DENY ALL BY DEFAULT FOR UNMATCHED PATHS
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
